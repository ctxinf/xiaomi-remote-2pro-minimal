# Copy to .env and fill in your key:  cp .env.example .env
#
# The hook reads this file from its own directory. Real keys belong in .env,
# which is gitignored; .env.example is committed and must stay value-free.

# Either name works; ASR_API_KEY wins if both are set.
ASR_API_KEY=
ALIBABA_API_KEY=

# Optional — the values below are the built-in defaults.
ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ASR_MODEL=qwen3-asr-flash

# Optional hints.
# Bare code, not BCP-47: "zh" works, "zh-CN" is rejected (auto-trimmed anyway).
ASR_LANGUAGE=zh
ASR_TIMEOUT_SEC=60
MAX_AUDIO_BYTES=8388608
