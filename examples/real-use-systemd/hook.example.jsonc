// 仅供 Python Hook 读取；API、剪贴板和桌面反馈不属于 Rust 网关。
{
  "asr": {
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "model": "qwen3-asr-flash",
    "api_key": "${secret:dashscope_api_key}",
    "language": "zh"
  },
  "llm": {
    "enabled": true,
    "model": "qwen-flash",
    "api_key": "${secret:llm_api_key}",
    "system_prompt": "你是语音转写的后处理器。输入是一段中文语音识别结果，可能有口癖、重复、缺标点。\n请输出清理后的文本：补全标点、去掉\"嗯/那个/就是\"之类的口水词、修正明显的同音错别字。\n不要翻译、不要扩写、不要总结、不要添加任何解释或前后缀，只输出清理后的正文。\n"
  },
  "output": {
    "clipboard": true,
    "notify": true,
    "indicator": {
      "enabled": false
    },
    "transcript": {
      "log": ""
    }
  }
}
